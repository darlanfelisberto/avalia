<server description="IFFar AVALIA Core Engine">

    <featureManager>
        <feature>servlet-6.1</feature>
        <feature>restfulWS-4.0</feature>
        <feature>cdi-4.1</feature>
        <feature>jsonb-3.0</feature>
        <feature>jsonp-2.1</feature>
        <feature>validation-3.1</feature>
        <feature>jdbc-4.3</feature>
        <feature>persistence-3.2</feature>
    </featureManager>

    <!-- Variáveis injetadas pelo container/SO ou com defaultValue vazio (sem credenciais fixas no fonte) -->
    <variable name="AVALIA_DB_IP" defaultValue="localhost"/>
    <variable name="AVALIA_DB_PORT" defaultValue="5432"/>
    <variable name="AVALIA_DB_DATABASE" defaultValue="avalia"/>
    <variable name="AVALIA_DB_USER" defaultValue=""/>
    <variable name="AVALIA_DB_PASSWORD" defaultValue=""/>

    <variable name="AVALIA_DB_SIG_IP" defaultValue=""/>
    <variable name="AVALIA_DB_SIG_PORT" defaultValue="5432"/>
    <variable name="AVALIA_DB_SIG_DATABASE" defaultValue="sigaa"/>
    <variable name="AVALIA_DB_SIG_USER" defaultValue=""/>
    <variable name="AVALIA_DB_SIG_PASSWORD" defaultValue=""/>

    <httpEndpoint id="defaultHttpEndpoint"
                  httpPort="9081"
                  httpsPort="9443"/>

    <!-- Para exibir logs detalhados de SQL no messages.log e console (descomente abaixo):
    <logging traceSpecification="*=info:eclipselink=fine:eclipselink.sql=fine:org.eclipse.persistence=fine"
             consoleLogLevel="INFO"/>
    -->

    <webApplication location="avalia.war" contextRoot="/">
    </webApplication>

    <!-- Driver JDBC PostgreSQL -->
    <library id="postgresqlLib">
        <fileset dir="${server.config.dir}/lib/global" includes="postgresql-*.jar"/>
    </library>

    <!-- DataSource oficial do AVALIA (Base Local) -->
    <dataSource id="AvaliaDataSource" jndiName="jdbc/avaliaDS">
        <jdbcDriver libraryRef="postgresqlLib"/>
        <properties.postgresql serverName="${AVALIA_DB_IP}" portNumber="${AVALIA_DB_PORT}"
                                databaseName="${AVALIA_DB_DATABASE}"
                                user="${AVALIA_DB_USER}" password="${AVALIA_DB_PASSWORD}"
                                stringType="unspecified"/>
    </dataSource>

    <!-- DataSource gerenciado do SIGAA (Base Remota para Integração - Contém schemas comum, rh, ensino e public) -->
    <dataSource id="SigaaDataSource" jndiName="jdbc/sigaaDS">
        <jdbcDriver libraryRef="postgresqlLib"/>
        <properties.postgresql serverName="${AVALI_DB_SIG_IP}" portNumber="${AVALIA_DB_SIG_PORT}"
                                databaseName="${AVALIA_DB_SIG_DATABASE}"
                                user="${AVALIA_DB_SIG_USER}" password="${AVALIA_DB_SIG_PASSWORD}"/>
    </dataSource>

</server>
