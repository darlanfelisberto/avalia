<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="avaliaPU" transaction-type="JTA">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <jta-data-source>jdbc/avaliaDS</jta-data-source>
        <class>br.edu.iffar.avalia.academico.model.Pessoa</class>
        <class>br.edu.iffar.avalia.avaliacao.model.ConjuntoOpcao</class>
        <class>br.edu.iffar.avalia.avaliacao.model.Entidade</class>
        <class>br.edu.iffar.avalia.avaliacao.model.EntidadeVinculo</class>
        <class>br.edu.iffar.avalia.avaliacao.model.InstrumentoAvaliativo</class>
        <class>br.edu.iffar.avalia.avaliacao.model.InstrumentoEntidadeAvaliada</class>
        <class>br.edu.iffar.avalia.avaliacao.model.InstrumentoSessao</class>
        <class>br.edu.iffar.avalia.avaliacao.model.InstrumentoTipoAlvo</class>
        <class>br.edu.iffar.avalia.avaliacao.model.InstrumentoTipoRespondente</class>
        <class>br.edu.iffar.avalia.avaliacao.model.OpcaoQuestao</class>
        <class>br.edu.iffar.avalia.avaliacao.model.Participacao</class>
        <class>br.edu.iffar.avalia.avaliacao.model.Questao</class>
        <class>br.edu.iffar.avalia.avaliacao.model.RespostaInstrumento</class>
        <class>br.edu.iffar.avalia.avaliacao.model.RespostaQuestao</class>
        <class>br.edu.iffar.avalia.avaliacao.model.SessaoQuestao</class>
        <class>br.edu.iffar.avalia.avaliacao.model.TipoEntidade</class>
        <class>br.edu.iffar.avalia.avaliacao.model.TipoEntidadePermissao</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <shared-cache-mode>ENABLE_SELECTIVE</shared-cache-mode>

        <properties>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.cache.use_second_level_cache" value="true"/>
            <property name="hibernate.cache.region.factory_class" value="jcache"/>
            <property name="hibernate.javax.cache.provider" value="com.github.benmanes.caffeine.jcache.spi.CaffeineCachingProvider"/>
            <property name="hibernate.javax.cache.missing_cache_strategy" value="create"/>

            <!-- Exibir SQLs gerados e parâmetros (equivalente ao show_sql) -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
